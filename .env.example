# Copy to .env.local and fill in. .env.local is never committed.
# Without the Supabase pair the site runs on src/content and only logs contact leads (front-end
# work without Docker). With a local Supabase (`pnpm supabase start`), `pnpm supabase status`
# prints the values: API URL, anon key and service_role key.

# Public: inlined into the browser bundle
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: never read these in client code
# service_role: invitations (admin) and integration tokens
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM="SDG Labs <contato@exemplo.com>"
